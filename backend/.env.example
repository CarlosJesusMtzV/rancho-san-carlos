# Docker usa .env de la raíz; Compose inyecta la conexión.
# Ejemplo opcional para ejecución manual con PostgreSQL propio.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tecnm_template;Username=tecnm_app;Password=REPLACE_LOCAL_PASSWORD"
# Opcional, ejecución manual: primer dueño si aún no hay cuentas (contraseña temporal).
Bootstrap__OwnerUsername=dueno
Bootstrap__OwnerPassword=REPLACE_TEMPORARY_PASSWORD
